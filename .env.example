# Cloudflare Account & Resource IDs
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
R2_BUCKET_NAME=

# Cloudflare Authentication Standard (Option A - Recommended):
# Scoped API Token with permissions: Account > D1 (Edit), Account > R2 Storage (Edit)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Authentication (Option B - Alternative Global API Key):
# Uncomment below if using legacy Global API Key instead of API Token:
# CLOUDFLARE_API_KEY=your_global_api_key_here
# CLOUDFLARE_EMAIL=your_cloudflare_account_email_here
