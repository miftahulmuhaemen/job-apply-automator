{
  "name": "job-apply-automator",
  "version": "1.0.0",
  "description": "Automated ATS-compliant daily job application engine via Pure Rust backend and Svelte 5 frontend",
  "type": "module",
  "scripts": {
    "dev": "cd frontend && bun run dev",
    "build": "cd frontend && bun run build",
    "web": "cargo run --manifest-path backend/Cargo.toml -- server",
    "e2e": "bun run e2e/runner.ts",
    "backend:build": "cargo build --release --manifest-path backend/Cargo.toml",
    "backend:status": "cargo run --manifest-path backend/Cargo.toml -- status",
    "backend:schedule": "cargo run --manifest-path backend/Cargo.toml -- schedule --once",
    "backend:browser": "cargo run --manifest-path backend/Cargo.toml -- browser"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.7.3"
  }
}
